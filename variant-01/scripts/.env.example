# Supabase COS Variant — environment template
# Copy to `.env` (gitignored) and fill in values from your Supabase project dashboard.
# Run `chmod 600 .env` after creation. Per ADR-0001: NEVER commit, NEVER share via Slack/PRs.

# === From Supabase dashboard → Project Settings → API ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiI...

# === Optimal AI human owner (Carter) ===
# Email used for the auth.users row; password used to sign in for verification tests.
OPTIMAL_OWNER_EMAIL=carter@get-optimal.ai
OPTIMAL_OWNER_PASSWORD=

# === COS sync agent (machine principal) ===
# This user gets app_metadata.role='agent' set via SQL in Stage 0.5.
COS_AGENT_EMAIL=cos-sync-agent@get-optimal.ai
COS_AGENT_PASSWORD=

# === Team config ===
OPTIMAL_TEAM_NAME=Optimal AI
OPTIMAL_TEAM_SLUG=optimal-ai
