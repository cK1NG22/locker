# ── Required ─────────────────────────────────────────────────────────────────

# Admin API key — used for all vault/team management endpoints (X-API-Key header)
# Pick any strong random string (e.g. openssl rand -hex 32)
LOCKER_API_KEY=change-me

# AES-256 encryption key for skill content at rest
# Generate one:  python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️  Losing this key = permanent data loss. Back it up securely.
LOCKER_ENCRYPTION_KEY=

# Your company's Anthropic API key — the proxy forwards calls to Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ─────────────────────────────────────────────────────────────────

# SQLite database path (default: ./locker.db)
# LOCKER_DB_PATH=./locker.db

# Vault base URL — used by the CLI and MCP server to reach the API
# LOCKER_VAULT_URL=http://localhost:8000

# Static file directories (defaults work inside Docker)
# LOCKER_STATIC_DIR=./static/companion
# LOCKER_DASHBOARD_DIR=./static/dashboard
